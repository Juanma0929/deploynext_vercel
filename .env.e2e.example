# Copy this file to .env.e2e.local (never committed) for `npm run test:e2e`.
# The users are the ones the API seed creates: SEED_ADMIN_* and SEED_SELLER_*
# of the .env of the API you test against.

E2E_ADMIN_EMAIL=admin@stockpyme.com
E2E_ADMIN_PASSWORD=
E2E_SELLER_EMAIL=seller@stockpyme.com
E2E_SELLER_PASSWORD=

# Where the frontend runs. Without it, Playwright builds and starts it on 3001.
# E2E_BASE_URL=http://localhost:3001
