# The NestJS API this frontend consumes. No trailing slash.
# Local:      http://localhost:3000
# Production: https://stockpyme-api.onrender.com

# Wompi sandbox public key. The card number is tokenised in the browser against
# Wompi, so the API never receives it. Public by design: it is not a secret.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# Accounts the Playwright suite logs in with. They are the users the seed of
# the API creates, and they are never written into the tests: the repository
# carries no credentials.
E2E_ADMIN_EMAIL=admin@stockpyme.com
E2E_ADMIN_PASSWORD=
E2E_SELLER_EMAIL=seller@stockpyme.com
E2E_SELLER_PASSWORD=

# Optional: point the suite at a running deployment instead of building and
# serving the application locally.
# PLAYWRIGHT_BASE_URL=https://icesi-2026b-2026b-nextjs-taller-gro.vercel.app
