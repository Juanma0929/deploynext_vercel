# The NestJS API this frontend consumes. No trailing slash.
# Local:      http://localhost:3000
# Production: https://stockpyme-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Wompi sandbox public key. The card number is tokenised in the browser against
# Wompi, so the API never receives it. Public by design: it is not a secret.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
